# Copy to .env and fill in real values. Never commit .env.
FORTYGUARD_API_KEY=your_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
DATABASE_URL=sqlite:///data/heatshield.db
# Optional: the deployed dashboard's own public URL (e.g. the Streamlit
# Cloud app URL). When set, high/extreme Slack alerts include a real
# clickable link to it, so a compliance-report PDF can actually be
# reached (Slack's incoming webhooks can't attach files) -- the alert
# just says "view on the dashboard" as plain text if this is unset.
DASHBOARD_URL=https://your-app.streamlit.app
